# Copy to parec.env (NOT committed) and fill in real values. The
# wrapper script sources this file before invoking the binary, so any
# KEY=VALUE here becomes an env var for the run.
#
# ROHLIK_EMAIL / ROHLIK_PASSWORD — credentials for the Rohlik login
#                                 flow (consumed by the binary).
# PAREC_RECIPIENT                — destination address(es) for the
#                                 monthly report (consumed by the
#                                 wrapper). Comma-separate for more
#                                 than one address.
ROHLIK_EMAIL="you@example.com"
ROHLIK_PASSWORD="changeme"
PAREC_RECIPIENT="you@example.com, someone-else@example.com"
